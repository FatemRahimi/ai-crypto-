# Copy this file to .env in the repository root.
# .env is gitignored. Use local values only. Do not put exchange API secrets here.

APP_ENV=local
# Reserved for future session signing. Phase 1 does not create sessions.
# Replace this before any shared or production deployment.
APP_SECRET_KEY=local-dev-only-change-me

# Used by `python -m app`. If port 8000 is already taken, set API_PORT=8001
# and point the frontend at that same port. Do not stop unrelated programs.
API_HOST=127.0.0.1
API_PORT=8000

# SQLAlchemy URL for the API. The password must match POSTGRES_PASSWORD below.
DATABASE_URL=postgresql+psycopg://aicrypto:local_dev_change_me@127.0.0.1:5432/aicrypto

# Public BTC market data. No API key. Leave unset to use the Binance public host.
# MARKET_DATA_BASE_URL=https://data-api.binance.vision
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
DEBUG=false

# Used by docker compose for the local PostgreSQL container only.
POSTGRES_USER=aicrypto
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_DB=aicrypto
